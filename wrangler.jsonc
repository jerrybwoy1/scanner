{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scanner",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BACKEND_URL": "https://qikreach-python-backend.onrender.com"
  }
}
